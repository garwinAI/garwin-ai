# Copy to .env.local (for `next dev`) and .env (for db scripts). Never commit real values.

# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/garwin

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First Admin account, created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
