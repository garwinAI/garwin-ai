# Garwin AI environment variables.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored: NEVER commit it.
# Every value below is a placeholder. Variables are validated at startup by src/lib/env.ts.

# --- Required ---------------------------------------------------------------

# Postgres connection string.
# Local (docker compose up -d): postgres://postgres:postgres@localhost:5432/garwin
# Production: use your provider's POOLED connection string (Neon/Supabase "pooler").
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Keys the hashes of session and email-link tokens. 32+ random characters, different in every
# environment. Changing it signs everyone out and invalidates pending email links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------

# Public URL of this deployment (default http://localhost:3000)
APP_URL=http://localhost:3000

# debug | info | warn | error (default info)
LOG_LEVEL=info

# First Admin account, used only by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-plus-characters

# --- Email (password reset, verification, security notices) ------------------
# Production REQUIRES Resend: the server refuses to start without RESEND_API_KEY.
# Locally, leave it blank and emails (with their links) are printed in the terminal.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
EMAIL_FROM=Garwin AI <no-reply@garwinai.com>

# --- SMS (team invitations by text message) -----------------------------------
# Twilio. Optional: without it, the "Text message" invite option is hidden in production
# (and texts are printed in the terminal in development). Set all three or none.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+15551234567) or a Messaging Service SID (MG...)
TWILIO_FROM=

# --- AppZone sandbox ----------------------------------------------------------
# Separate origin that serves AppZone app bundles and images, never this app's own domain
# (e.g. https://garwinapps.com). Bare origin only: https, no path. Locally you may use
# http://localhost:4000. Blank = marketplace apps show "Temporarily unavailable".
APPZONE_SANDBOX_ORIGIN=

# --- Later phases (leave blank until that phase) ------------------------------

# Phase 2: Stripe (use TEST keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 7: Assistant AI provider
# Anthropic API key (console.anthropic.com -> API Keys). The Assistant runs on Claude.
ASSISTANT_API_KEY=

# --- Testing ------------------------------------------------------------------

# Optional: use an installed Chrome for `npm run test:e2e` instead of Playwright's download
# PW_CHROMIUM_PATH=
