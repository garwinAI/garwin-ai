# Copy to .env.local (for `next dev`) and .env (for db scripts). Never commit real values.

# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/garwin

# Random string (32+ characters) used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First Admin account, created by `npm run db:seed`. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Later phases: leave blank for now ---------------------------------------
# The Admin health page only checks whether these are set; nothing uses them yet.

# Phase 2: Stripe (use TEST keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 7: Assistant AI provider
ASSISTANT_API_KEY=
