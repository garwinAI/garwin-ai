# Garwin AI environment variables.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored: NEVER commit it.
# Every value below is a placeholder. Variables are validated at startup by src/lib/env.ts.

# --- Required ---------------------------------------------------------------

# Postgres connection string.
# Local (docker compose up -d): postgres://postgres:postgres@localhost:5432/garwin
# Production: use your provider's POOLED connection string (Neon/Supabase "pooler").
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Signs session cookies. 32+ random characters, different in every environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------

# Public URL of this deployment (default http://localhost:3000)
APP_URL=http://localhost:3000

# debug | info | warn | error (default info)
LOG_LEVEL=info

# First Admin account, used only by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-plus-characters

# --- Later phases (leave blank until that phase) ------------------------------

# Phase 2: Stripe (use TEST keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 7: Assistant AI provider
ASSISTANT_API_KEY=

# --- Testing ------------------------------------------------------------------

# Optional: use an installed Chrome for `npm run test:e2e` instead of Playwright's download
# PW_CHROMIUM_PATH=
